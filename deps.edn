{:paths ["src"]
 ;; kotobase-server -- platform-independent XRPC handler + async/sync storage
 ;; bridge for a kotobase-peer-backed worker. No deploy surface, no
 ;; Cloudflare/R2/B2-specific code -- see README.md.
 ;; kotobase-peer pin: feature-frozen engine facade after the capability
 ;; split. Projection, federation, and maintenance behavior now lives in
 ;; their dedicated repositories; compatibility namespaces remain here.
 ;; kotobase-client pin: picks up kotobase.cid/did-key->ed25519-pub's
 ;; fail-closed fix (returns nil, not a throw, on malformed base58) --
 ;; kotobase.server.ipns requires kotobase.ipns (kotobase-client), whose
 ;; verify-head calls did-key->ed25519-pub directly to resolve the
 ;; signer's pubkey for every IPNS record signature check.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; datom-source is the IPatternSource contract kotobase.server.
        ;; pattern-source implements (superproject ADR-2608039970). Zero deps
        ;; of its own; kotobase-client carries the shared index plan.
        io.github.kotoba-lang/datom-source
        {:git/url "https://github.com/kotoba-lang/datom-source.git"
         :git/sha "19dc98ad5272da6648c27eada8e1ed76cac85d8d"}
        ;; PIN ALIGNMENT, and it is load-bearing. org-w3-sparql-protocol pulls
        ;; kotobase-query -> arrangement 9e90426, which tools.deps selects over
        ;; the f4e3118 kotobase-peer depends on (:newer-version wins silently).
        ;; Measured 2026-08-04: taking the surface WITHOUT these three pins
        ;; turned 78/332 green into 16 failures in fold and hot-db caching —
        ;; the engine's own libraries swapped out from under it by a query
        ;; surface's transitive tree. Top-level deps win, so they are stated.
        ;;
        ;; Advanced together 2026-09-10 with the kotobase-peer pin below.
        ;; These floors are a RATCHET, not a freeze: held at their 2026-08
        ;; values they became OLDER than what kotobase-peer was built against,
        ;; and the same three names broke the same way in the same places --
        ;; 53 failures + 1 error, every read answering empty. arrangement
        ;; 9c9f45d still dominates the 9e90426 the sparql surface pulls in
        ;; (checked: 9e90426 is an ancestor), so the 2026-08 protection is
        ;; intact and the pin is merely no longer behind the engine.
        ;;
        ;; datom-source moved with them, and its evidence is different in kind.
        ;; arrangement 9c9f45d calls `ds/in-range?`, `ds/scan-range` and
        ;; `ds/IAsyncPatternSource`, none of which exist at b42f6e6. NONE of
        ;; the 182 tests went red: ClojureScript reports an undeclared var in
        ;; another namespace as a WARNING and emits the call anyway, so the
        ;; suite stayed green over 8 `:undeclared-var` warnings (baseline had
        ;; 0). nbb resolves at runtime and threw instead, which is the only
        ;; reason this was seen at all. The floor to read here is the warning
        ;; count, not the failure count.
        ;;
        ;; datom-source is pinned at 19dc98a -- what arrangement 9c9f45d
        ;; itself names -- and deliberately NOT at its west pin 95cc74c, which
        ;; renamed every source file from .cljc to .kotoba. Neither
        ;; shadow-cljs nor nbb reads .kotoba, so that pin is unusable from any
        ;; cljs consumer; this one is behind west on purpose.
        io.github.kotoba-lang/arrangement
        {:git/url "https://github.com/kotoba-lang/arrangement.git"
         :git/sha "9c9f45d4cd043873cd5c5ea65fa3af8a8ead5e6d"}
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}
        io.github.kotoba-lang/prolly-tree
        {:git/url "https://github.com/kotoba-lang/prolly-tree.git"
         :git/sha "3a12dd2b77430007031e408ee8db75d35f1757a1"}
        io.github.kotoba-lang/org-w3-sparql-protocol
        {:git/url "https://github.com/kotoba-lang/org-w3-sparql-protocol.git"
         :git/sha "49c59208442753458daf1dacbf15e1ba6539507f"}
        ;; The delegation wire (root ADR-2608180200). Verification needs only
        ;; the root PUBLIC key, which is what lets it run at an edge; the CACAO
        ;; path beside it is unchanged and still the live one.
        io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/dev-protobuf.git"
         :git/sha "3f20b1e1cdbe89750d8afaf24f64777a2f170c3c"}
        io.github.kotoba-lang/org-biscuitsec
        {:git/url "https://github.com/kotoba-lang/org-biscuitsec.git"
         :git/sha "4c05fa54ecb2b502ef64eabeb8070759b6a63541"}
        io.github.kotoba-lang/authority
        {:git/url "https://github.com/kotoba-lang/authority.git"
         :git/sha "232eef9b7969aa5990f9b5e48b1184f078500781"}
        ;; ADR-2607280100 Step 5. Advanced 4926d13 -> d7dba09 (84 commits) to
        ;; pick up four-level clearance in `kotobase-peer.policy`, which is
        ;; what gives this server a classification layer at all: the judgment
        ;; stays in one place (D6) and this repo only has to let it be
        ;; reached. Nothing in src/ requires `kotoba.security.*` and nothing
        ;; should -- the lattice arrives through kotobase-peer, which declares
        ;; it. A `security` coordinate here that no namespace reads would be a
        ;; dependency with no reader.
        io.github.kotoba-lang/kotobase-peer
        {:git/url "https://github.com/kotoba-lang/kotobase-peer.git"
         :git/sha "d7dba097243612012f08fa9aca22f2021bd4055f"}
        io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotobase-client.git"
         :git/sha "97d44a184eb4eea5a0cca737d3c9771fde4b73ec"}
        ;; src/kotobase/server/storage.cljk (landed via #13's untracked-WIP
        ;; cleanup, 2026-07-26) requires kotobase.storage.core, but nothing
        ;; declared this dependency -- main's own CI has been red since that
        ;; merge (shadow-cljs node-test: "required namespace kotobase.storage
        ;; .core is not available"). Pinned here, unrelated to this PR's
        ;; fold/view change, just to unbreak the build.
        io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotobase-storage.git"
         :git/sha "5cbf6c5107ad49c0daac14dca118c837053de0d6"}
        io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "e7c1b250adf3291ef99424fa85d8e7381cb086fb"}
        io.github.kotoba-lang/org-ietf-hpke
        {:git/url "https://github.com/kotoba-lang/org-ietf-hpke.git"
         :git/sha "51486cce0fc2f94e4173a100e8f8cb411aeb1422"}
        io.github.kotoba-lang/org-nist-aes
        {:git/url "https://github.com/kotoba-lang/org-nist-aes.git"
         :git/sha "d021bbe9f2d516d63bbbb2dd594aed93148fdf50"}}
 :aliases
 {:cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test-node
  {:extra-paths ["test"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
